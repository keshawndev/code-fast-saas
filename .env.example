# Copy this file to .env.local and fill in the values:
#   cp .env.example .env.local
# Never commit .env.local. It holds real secrets.
#
# Variables marked [compose] are set by docker-compose.yml for local
# containers, so you only need them in .env.local for `npm run dev`.
# Each deployed environment (dev/staging/prod) sets its own values.

# ---------------------------------------------------------------------
# App URLs
# ---------------------------------------------------------------------
# Public URL where users reach the app. Different in every environment.

# Base URL for shareable board links. Read on the server at request
# time, so one image works in every environment.
# Required for `npm run dev`. [compose]
APP_URL=http://localhost:3000

# URL Auth.js uses to build sign-in callback URLs. Optional for
# `npm run dev` (detected from the request); required in containers.
# [compose]
AUTH_URL=http://localhost:3000

# ---------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------
# MongoDB connection string. For `npm run dev`, use a MongoDB Atlas URL.
# [compose] points this at the local mongo container.
MONGO_URI=

# ---------------------------------------------------------------------
# Auth.js
# ---------------------------------------------------------------------
# Secret used to sign sessions. Generate one with:
#   openssl rand -base64 32
AUTH_SECRET=

# Trust the Host header from a proxy or load balancer. Needed when
# running outside Vercel (containers, AWS). [compose]
AUTH_TRUST_HOST=true

# ---------------------------------------------------------------------
# Sign-in providers
# ---------------------------------------------------------------------
# Resend API key for email sign-in links. The sender address is set in
# auth.js and its domain must be verified in Resend.
RESEND_KEY=

# Google OAuth client (Google Cloud Console > APIs & Services > Credentials).
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
GOOGLE_ID=
GOOGLE_SECRET=

# ---------------------------------------------------------------------
# Stripe (use test-mode keys: sk_test_...)
# ---------------------------------------------------------------------
STRIPE_API_KEY=
STRIPE_PRICE_ID=

# Webhook signing secret. Locally, use the whsec_... value printed by:
#   stripe listen --forward-to localhost:3000/api/webhook
STRIPE_WEBHOOK_SECRET=
